# fihi-chifae — MySQL 8.4 tuned for a small shop (~120-160 MB RSS).
# Data set is a few MB: small caches are enough, features we do not use are off.
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
skip-name-resolve
mysqlx               = OFF
performance_schema   = OFF
disable_log_bin                       # no replication: no binary logs (disk + I/O)

max_connections      = 40
thread_cache_size    = 8
thread_stack         = 256K
table_open_cache     = 256
table_definition_cache = 256
open_files_limit     = 2048

innodb_buffer_pool_size      = 64M
innodb_log_buffer_size       = 4M
innodb_redo_log_capacity     = 32M
innodb_flush_log_at_trx_commit = 1     # durable: every commit is on disk
innodb_flush_method          = O_DIRECT
innodb_io_capacity           = 200
innodb_read_io_threads       = 1
innodb_write_io_threads      = 1
innodb_purge_threads         = 1
innodb_page_cleaners         = 1

key_buffer_size      = 1M
tmp_table_size       = 8M
max_heap_table_size  = 8M
sort_buffer_size     = 256K
join_buffer_size     = 256K
read_buffer_size     = 128K
read_rnd_buffer_size = 256K
max_allowed_packet   = 32M

log_error_verbosity  = 2
